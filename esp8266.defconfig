# crosstool-NG configuration of the ESP8266 toolchain (xtensa-esp8266-elf).
#
# The processor configuration of the ESP8266 (Xtensa lx106 core) is applied
# using the overlay from https://github.com/espressif/xtensa-overlays. The
# newlib options match the gschorcht/xtensa-esp8266-elf toolchain, but
# retargetable locking is enabled additionally, which RIOT maps to its own
# mutex implementation. Libgloss is disabled, since it assumes the windowed
# ABI, whereas the lx106 core only supports the call0 ABI.
#
# Newlib 4.5 is not used since its release tarball does not install the Xtensa
# core configuration headers for libm, and the overlay targets the older
# directory layout used up to newlib 4.4.
#
# The GDB part of the overlay is patched to match the interface of GDB 13 and
# newer, see patches/xtensa-overlays/.
#
# The installation directory is taken from the TOOLCHAIN_PREFIX environment
# variable, and defaults to /opt/esp/xtensa-esp8266-elf. The directory is not
# removed before building, so that it can be created upfront by a user with
# write permissions to its parent directory.
CT_CONFIG_VERSION="4"
CT_PREFIX_DIR="${TOOLCHAIN_PREFIX:-/opt/esp/xtensa-esp8266-elf}"
# CT_PREFIX_DIR_RO is not set
# CT_RM_RF_PREFIX_DIR is not set
CT_LOG_PROGRESS_BAR=n
CT_ARCH_XTENSA=y
CT_XTENSA_CUSTOM=y
CT_OVERLAY_NAME="esp8266"
CT_OVERLAY_LOCATION="/opt/xtensa-overlays"
CT_TARGET_CFLAGS="-mlongcalls"
CT_TARGET_VENDOR="esp8266"
CT_STRIP_HOST_TOOLCHAIN_EXECUTABLES=y
CT_BINUTILS_V_2_43=y
CT_NEWLIB_V_4_4=y
CT_LIBC_NEWLIB_TARGET_CFLAGS=""
CT_LIBC_NEWLIB_IO_C99FMT=y
CT_LIBC_NEWLIB_IO_LL=y
CT_LIBC_NEWLIB_IO_FLOAT=y
CT_LIBC_NEWLIB_REENT_SMALL=y
CT_LIBC_NEWLIB_RETARGETABLE_LOCKING=y
CT_LIBC_NEWLIB_DISABLE_SUPPLIED_SYSCALLS=y
CT_LIBC_NEWLIB_ENABLE_TARGET_OPTSPACE=y
CT_LIBC_NEWLIB_EXTRA_CONFIG_ARRAY="--disable-libgloss"
CT_GCC_V_14=y
CT_CC_LANG_CXX=y
CT_CC_GCC_ENABLE_CXX_FLAGS="-ffunction-sections -fdata-sections"
CT_DEBUG_GDB=y
CT_GDB_V_15=y
# CT_GDB_CROSS_PYTHON is not set
