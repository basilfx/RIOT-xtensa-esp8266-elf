# crosstool-NG configuration of the MIPS toolchain (mips-mti-elf), for the
# PIC32MX and PIC32MZ devices of Microchip.
#
# The target triplet matches the MIPS toolchain of Imagination Technologies,
# which RIOT used before. Like that toolchain, the compiler defaults to
# mips32r2, big-endian and hard-float. RIOT selects the little-endian,
# soft-float multilibs using -EL and -msoft-float. GCC is patched to only build
# the little-endian multilibs of mips32r2, since the PIC32 devices are
# little-endian only, see patches/.
#
# Newlib 4.6 is used, since it is the first release that contains the MIPS
# hardware abstraction layer (libhal, <mips/*.h>) and the Unified Hosting
# Interface (libuhi), as well as the boot code and linker scripts that RIOT
# uses (bootcode.ld and uhi32.ld). Therefore, libgloss is built. Libgloss is
# patched, since the UHI implementation of fstat() assumes a 32-bit time_t. The
# C library is configured like for the ESP8266 toolchain.
#
# The installation directory is taken from the TOOLCHAIN_PREFIX environment
# variable, and defaults to /opt/mips-mti-elf. The directory is not removed
# before building, so that it can be created upfront by a user with write
# permissions to its parent directory.
CT_CONFIG_VERSION="4"
CT_PREFIX_DIR="${TOOLCHAIN_PREFIX:-/opt/mips-mti-elf}"
# CT_PREFIX_DIR_RO is not set
# CT_RM_RF_PREFIX_DIR is not set
CT_LOG_PROGRESS_BAR=n
CT_PATCH_BUNDLED_LOCAL=y
CT_LOCAL_PATCH_DIR="/home/build/toolchain/patches"
CT_ARCH_MIPS=y
CT_MULTILIB=y
CT_TARGET_VENDOR="mti"
CT_STRIP_HOST_TOOLCHAIN_EXECUTABLES=y
CT_BINUTILS_V_2_43=y
CT_NEWLIB_V_4_6=y
CT_LIBC_NEWLIB_IO_C99FMT=y
CT_LIBC_NEWLIB_IO_LL=y
CT_LIBC_NEWLIB_IO_FLOAT=y
CT_LIBC_NEWLIB_REENT_SMALL=y
CT_LIBC_NEWLIB_RETARGETABLE_LOCKING=y
CT_LIBC_NEWLIB_DISABLE_SUPPLIED_SYSCALLS=y
CT_LIBC_NEWLIB_ENABLE_TARGET_OPTSPACE=y
CT_GCC_V_15=y
CT_CC_LANG_CXX=y
CT_CC_GCC_ENABLE_CXX_FLAGS="-ffunction-sections -fdata-sections"
CT_DEBUG_GDB=y
CT_GDB_V_15=y
# CT_GDB_CROSS_PYTHON is not set
